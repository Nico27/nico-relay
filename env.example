# Copy to `.env` (Docker Compose reads it automatically) and adjust if needed.

# Postgres
POSTGRES_DB=relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay

# Host ports (5432/8000/5173 are often taken by other local stacks)
DB_HOST_PORT=55432
API_HOST_PORT=8010
WEB_HOST_PORT=5180

# Load seed.sql on container start (reset + reload). Set to 0 to keep your data.
SEED_ON_START=1

# How many preceding weeks form the "normal" baseline.
BASELINE_WEEKS=8
